<BotonTemaEscuela@Button>:
    size_hint_y: None
    height: dp(65)
    font_size: '16sp'
    background_color: 0.2, 0.6, 0.8, 1
    background_normal: 'assets/ui/button.png'
    background_down: 'assets/ui/button_down.png'
    border: 0, 0, 0, 0
    bold: True

<FilaUnidadEscuela>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    padding: [dp(15), dp(5)]
    spacing: dp(10)

    # Tarjeta Flotante (Card UI) para cada lección
    canvas.before:
        Color:
            # Blanco semi-opaco, mutando a azulado al ser presionado
            rgba: (0.9, 0.95, 1, 0.95) if self.state == 'down' else (0.98, 0.98, 0.98, 0.95)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

        Color:
            # Borde estructural cian
            rgba: 0.2, 0.6, 0.8, 0.6
        Line:
            width: 1.2
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))

    Label:
        text: root.texto_unidad
        font_name: 'Michroma'
        font_size: '16sp'
        color: 0.1, 0.2, 0.3, 1
        halign: 'left'
        valign: 'middle'
        text_size: self.size

        # ¡La guillotina del warning! Unificamos el padding horizontal (10) y vertical (0)
        padding: [dp(10), 0]

        bold: True

    CheckBox:
        size_hint_x: 0.2
        active: root.completada
        # Inyección de verde radiactivo para contrastar con el blanco
        color: 0.1, 0.6, 0.2, 1
        on_active: root.al_alternar(self.active)

<PantallaEscuelaTemas>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(25)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'assets/ui/bg_2.png'

        Label:
            text: '[b]ESCUELA DE AJEDREZ[/b]'
            markup: True
            font_size: '22sp'
            size_hint_y: 0.15
            color: 0.1, 0.5, 0.6, 1 # Ajustado para que contraste mejor con el cielo

        # El contenedor ahora es 100% invisible, solo organiza el espacio
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.70
            pos_hint: {'center_x': 0.5}
            padding: dp(10)

            # ¡Hemos aniquilado el asqueroso canvas.before de este contenedor!

            ScrollView:
                do_scroll_x: False
                GridLayout:
                    id: grid_temas
                    cols: 1
                    spacing: dp(12) # Más espacio entre tarjetas para que se vea el cielo
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(5), dp(10)]

        AnchorLayout:
            size_hint_y: 0.15
            Button:
                text: 'VOLVER AL MENU'
                font_size: '14sp'
                size_hint: 0.75, None
                height: dp(50)
                background_color: 0.8, 0.4, 0.1, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.volver_menu()

<PantallaEscuelaUnidades>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(25)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'assets/ui/bg_3.png'

        Label:
            id: lbl_titulo_tema
            text: '[b]TEMA SELECCIONADO[/b]'
            markup: True
            font_size: '22sp'
            size_hint_y: 0.15
            color: 0.1, 0.5, 0.6, 1

        # Contenedor invisible organizador
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.70
            pos_hint: {'center_x': 0.5}
            padding: dp(10)

            ScrollView:
                do_scroll_x: False
                GridLayout:
                    id: grid_unidades
                    cols: 1
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(5), dp(10)]

        BoxLayout:
            size_hint_y: None
            height: dp(55)
            spacing: dp(15)
            padding: [dp(25), dp(0)]

            Button:
                text: 'VOLVER'
                font_size: '14sp'
                background_color: 0.8, 0.4, 0.1, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.volver_temas()

            Button:
                text: 'SIGUIENTE'
                font_size: '14sp'
                background_color: 0.2, 0.8, 0.4, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.siguiente_unidad()

<TextoLeccion@Label>:
    font_size: '14sp'
    font_name: 'Michroma'
    color: 0.9, 0.9, 0.9, 1
    # Obligamos al texto a encajarse en la tarjeta
    text_size: self.size
    halign: 'left'
    valign: 'top'
    markup: True

<ContenedorTableroMini@AnchorLayout>:
    size_hint_y: None
    # Mantenemos proporciones cuadradas basándonos en el ancho
    height: self.width * 0.8
    GridLayout:
        id: grid
        cols: 8
        rows: 8
        size_hint: None, None
        width: root.width * 0.8
        height: root.width * 0.8
        canvas.before:
            Color:
                rgba: 0.8, 0.6, 0.1, 1
            Line:
                width: 1.5
                rectangle: self.x, self.y, self.width, self.height

<PantallaVisorUnidad>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'assets/ui/bg_3.png'

        Label:
            id: lbl_titulo
            text: '[b]TITULO DE LA LECCION[/b]'
            markup: True
            font_size: '22sp'
            size_hint_y: 0.1
            color: 0.05, 0.15, 0.25, 1

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.8
            padding: dp(20)
            spacing: dp(15)
            canvas.before:
                Color:
                    rgba: 0.05, 0.15, 0.25, 0.8
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(15)]
                Color:
                    rgba: 0.2, 0.6, 0.8, 0.6
                Line:
                    width: 1.5
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(15))

            BoxLayout:
                id: contenedor_contenido
                orientation: 'vertical'
                spacing: dp(15)

        BoxLayout:
            size_hint_y: None
            height: dp(55)
            spacing: dp(10)

            Button:
                text: 'ANTERIOR'
                font_size: '14sp'
                background_color: 0.2, 0.6, 0.8, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.pagina_anterior()

            Button:
                text: 'TEMARIO'
                font_size: '14sp'
                background_color: 0.8, 0.4, 0.1, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.volver_unidades()

            Button:
                text: 'SIGUIENTE'
                font_size: '14sp'
                background_color: 0.2, 0.8, 0.4, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.pagina_siguiente()

<FilaTemaProgreso@ButtonBehavior+BoxLayout>:
    # Propiedades dinámicas inyectadas por el Controlador
    texto_tema: ''
    porcentaje: 0
    id_tema: ''
    controlador: None

    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    padding: [dp(20), dp(5)]
    spacing: dp(15)

    # Diseño de Tarjeta Flotante (Card UI)
    canvas.before:
        Color:
            # Blanco puro semi-opaco, se vuelve azulado al pulsar
            rgba: (0.9, 0.95, 1, 0.95) if self.state == 'down' else (0.98, 0.98, 0.98, 0.95)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

        Color:
            # Borde elegante azul cian para enmarcar la tarjeta
            rgba: 0.2, 0.6, 0.8, 0.6
        Line:
            width: 1.2
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))

    on_release:
        if root.controlador: root.controlador.abrir_tema(root.id_tema)

    Label:
        text: root.texto_tema
        font_name: 'Michroma'
        font_size: '16sp'
        color: 0.1, 0.2, 0.3, 1  # Texto oscuro y profesional
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        bold: True

    Label:
        text: f"{root.porcentaje}%"
        font_name: 'Michroma'
        font_size: '16sp'
        color: (0.1, 0.6, 0.2, 1) if root.porcentaje == 100 else (0.8, 0.4, 0.1, 1)
        size_hint_x: None
        width: dp(55)
        halign: 'right'
        valign: 'middle'
        bold: True

    Label:
        text: '»'
        font_name: 'Michroma'
        font_size: '22sp'
        color: 0.2, 0.6, 0.8, 0.8
        size_hint_x: None
        width: dp(25)
        halign: 'center'
        valign: 'middle'
        bold: True

<PantallaMenuLeccion>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(25)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'assets/ui/bg_3.png'

        # El título obligado a acatar los saltos de línea y centrarse
        Label:
            id: lbl_titulo_leccion
            text: ''
            markup: True
            halign: 'center'
            valign: 'middle'
            font_size: '22sp'
            color: 0.1, 0.5, 0.6, 1
            # Magia negra para el word-wrap
            size_hint_y: None
            text_size: self.width, None
            height: self.texture_size[1] + dp(20)

        # Contenedor de las tarjetas anclado a la parte superior
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 1
            pos_hint: {'center_x': 0.5}
            padding: dp(10)

            ScrollView:
                do_scroll_x: False
                size_hint_y: None
                height: grid_partes.minimum_height

                GridLayout:
                    id: grid_partes
                    cols: 1
                    spacing: dp(15)
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(5), dp(10)]

            # Este Widget vacío es el verdugo que empuja todo hacia arriba
            Widget:
                size_hint_y: 1

        # Botón inferior para retroceder
        BoxLayout:
            size_hint_y: None
            height: dp(55)
            spacing: dp(15)
            padding: [dp(25), dp(0)]

            Button:
                text: 'VOLVER'
                font_size: '14sp'
                background_color: 0.8, 0.4, 0.1, 1
                background_normal: 'assets/ui/button.png'
                background_down: 'assets/ui/button_down.png'
                border: 0, 0, 0, 0
                bold: True
                on_release: root.volver_unidades()

<FilaParteLeccion>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    padding: [dp(15), dp(5)]
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: (0.9, 0.95, 1, 0.95) if self.state == 'down' else (0.98, 0.98, 0.98, 0.95)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: 0.2, 0.6, 0.8, 0.6
        Line:
            width: 1.2
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))

    Label:
        text: root.texto_parte
        font_name: 'Michroma'
        font_size: '16sp'
        color: 0.1, 0.2, 0.3, 1
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        padding: [dp(10), 0]
        bold: True

    CheckBox:
        size_hint_x: 0.2
        active: root.completada
        color: 0.1, 0.6, 0.2, 1
        disabled: True

<VistaLeccion>:
    orientation: 'vertical'
    padding: dp(20)
    spacing: dp(15)
    canvas.before:
        Color:
            rgba: 0.12, 0.29, 0.42, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: '[b]ENTRENAMIENTO TACTICO[/b]'
        font_size: '22sp'
        markup: True
        bold: True
        size_hint_y: 0.15
        color: 0.2, 0.8, 0.4, 1

    AnchorLayout:
        size_hint_y: 0.55
        BoxLayout:
            size_hint: None, None
            width: cuadricula_tablero.width + dp(4)
            height: cuadricula_tablero.height + dp(4)
            canvas.before:
                Color:
                    rgba: 0.8, 0.6, 0.1, 1
                Line:
                    width: 1.5
                    rectangle: self.x, self.y, self.width, self.height
            GridLayout:
                id: cuadricula_tablero
                cols: 8
                rows: 8
                size_hint: None, None
                width: min(root.width - dp(40), root.height * 0.55)
                height: self.width

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.30
        spacing: dp(10)

        Label:
            id: lbl_estado
            text: 'Analiza la posicion...'
            font_size: '14sp'
            bold: True
            markup: True
            color: 0.9, 0.9, 0.9, 1
            text_size: self.size
            halign: 'center'
            valign: 'middle'

        Button:
            id: btn_continuar
            text: 'SIGUIENTE'
            size_hint_x: None
            width: dp(160)
            pos_hint: {'center_x': 0.5}
            size_hint_y: None
            height: dp(50)
            background_color: 0.2, 0.6, 0.8, 1
            background_normal: 'assets/ui/button.png'
            background_down: 'assets/ui/button_down.png'
            border: 0, 0, 0, 0
            bold: True
            opacity: 0
            disabled: True
            on_release: root.retornar_visor()